{
  // 이미지(Dockerfile)를 수정·테스트할 때만 사용. 평소에는 기본 설정(공용 이미지)을 쓴다.
  "name": "MAD ROS2 (로컬 빌드 - 관리자용)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "args": { "ROS_DISTRO": "humble" }
  },
  "remoteUser": "ubuntu",
  "workspaceMount": "source=${localWorkspaceFolder},target=/ws,type=bind",
  "workspaceFolder": "/ws",
  "containerEnv": {
    "ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:0}",
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "runArgs": ["--network=host", "--ipc=host", "--volume=/tmp/.X11-unix:/tmp/.X11-unix"],
  "postCreateCommand": "./scripts/setup.sh"
}
