{
  // 기본: 팀 공용 이미지(GHCR)를 받아 사용 → 본체 노트북과 동일한 환경.
  // 이미지 이름은 config/teams.yml 의 org 로부터 scripts/teams.py sync 가 채운다.
  "name": "anjabom ROS2 (공용 이미지)",
  "image": "ghcr.io/change_me/anjabom-dev:humble",
  "remoteUser": "ubuntu",
  "workspaceMount": "source=${localWorkspaceFolder},target=/ws,type=bind",
  "workspaceFolder": "/ws",
  "containerEnv": {
    // 같은 네트워크의 다른 팀원과 토픽이 섞이지 않도록 사람마다 다른 값(TEAM_GUIDE.md)
    "ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:0}",
    // rviz2 등 GUI (우분투 X11 / 윈도우 WSLg)
    "DISPLAY": "${localEnv:DISPLAY}",
    // AI 코딩 도구: 설치할 도구 목록(none 이면 설치 안 함)과, 구독 로그인 대신 API 키를 쓸 때의 키
    "ANJABOM_AI_TOOLS": "${localEnv:ANJABOM_AI_TOOLS:claude codex grok}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "XAI_API_KEY": "${localEnv:XAI_API_KEY}"
  },
  // AI 도구 실행 파일과 로그인 정보를 볼륨에 보관 → Rebuild Container 후에도 다시 로그인할 필요 없음
  "mounts": [
    "source=anjabom-ai-bin,target=/home/ubuntu/.local,type=volume",
    "source=anjabom-ai-config,target=/home/ubuntu/.ai-config,type=volume"
  ],
  "runArgs": [
    "--network=host",
    "--ipc=host",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix"
    // ── 본체 노트북 성능에 맞추기: python3 scripts/env_check.py 가 알려 주는 값으로 주석 해제
    // ,"--cpus=4", "--memory=8g"
    // ── 실제 센서/아두이노(USB) 사용 시 주석 해제
    // ,"--privileged", "--volume=/dev:/dev"
  ],
  "postCreateCommand": "./scripts/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode.cpptools",
        "ranch-hand-robotics.rde-pack",
        "redhat.vscode-yaml",
        "github.vscode-pull-request-github",
        "eamodio.gitlens"
      ]
    }
  }
}
